{
  "name": "flexdeck-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The official FlexDeck plugin repository: first-party plugins, recipes, and the packages and index the app installs from.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "bump": "node scripts/bump.mjs",
    "test": "node --test scripts/*.test.mjs && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "node scripts/build.mjs",
    "index": "node scripts/build.mjs --index-only",
    "release": "node scripts/release.mjs",
    "link-sdk": "node scripts/link-sdk.mjs"
  },
  "dependencies": {
    "@flexdeck/plugin-sdk": "^0.1.0"
  }
}
